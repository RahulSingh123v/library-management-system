# ─────────────────────────────────────────────────────────────
# LibraryOS — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to git.
# ─────────────────────────────────────────────────────────────

# ── Django Core ───────────────────────────────────────────────
# Generate a new key at: https://djecrety.ir/
SECRET_KEY=your-secret-key-here-change-this

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hosts
# e.g. localhost,127.0.0.1,yourapp.vercel.app
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# Comma-separated CSRF trusted origins (must include your Vercel domain)
CSRF_TRUSTED_ORIGINS=https://yourapp.vercel.app,http://localhost:8000

# ── Database ──────────────────────────────────────────────────
# Leave empty to use SQLite (/tmp on Vercel, project dir locally)
# Set to a PostgreSQL URL for persistent production data:
# Format: postgres://user:password@host:5432/dbname
DATABASE_URL=

# ── Timezone ──────────────────────────────────────────────────
TIME_ZONE=UTC

# ── Email (optional) ─────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@libraryos.com
